# Copy to .env (which is git-ignored) and fill in, or export these in your shell.
#
# Baserow personal/database API token with read + (for write-back) create-field
# and edit-row rights on database 206 / table 1026.
BASEROW_TOKEN=

# Biohub ESMC API token. NOTE: the esm SDK also reads ESM_API_KEY; we map
# BIOHUB_API_TOKEN -> the client automatically, so you only need to set this one.
BIOHUB_API_TOKEN=

# Optional: multiple Biohub tokens to round-robin across (e.g. several accounts),
# so the effective daily credit budget is their sum and the run fails over when
# one token hits its cap. Comma- or whitespace-separated. Takes precedence over
# (and is merged with) the single BIOHUB_API_TOKEN above.
# BIOHUB_API_TOKENS=token_one,token_two,token_three
