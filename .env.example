# Copy to .env (which is git-ignored) and fill in, or export these in your shell.
#
# Baserow personal/database API token with read + (for write-back) create-field
# and edit-row rights on database 206 / table 1026.
BASEROW_TOKEN=

# Biohub ESMC API token. NOTE: the esm SDK also reads ESM_API_KEY; we map
# BIOHUB_API_TOKEN -> the client automatically, so you only need to set this one.
BIOHUB_API_TOKEN=
